        "false_positive_risk": "None"
      },
      "tags": ["audit", "auditing", "monitoring", "workstation", "level2", "critical"]
    },
    {
      "rule_id": "CIS-WS-L2-4.1.1.2",
      "rule_name": "Ensure auditd service is enabled and running",
