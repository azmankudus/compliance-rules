      "remediation": {
        "remediation_step": "Configure pam_faillock with deny=5 unlock_time=900",
        "rollback_supported": true,
        "reboot_required": false,
        "service_impact": "Accounts may be locked after failed attempts",
        "estimated_time": "5 minutes"
      },
      "context": {
