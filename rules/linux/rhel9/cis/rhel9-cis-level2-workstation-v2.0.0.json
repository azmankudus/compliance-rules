  "rules": [
    {
      "rule_id": "CIS-WS-L2-1.1.1.1",
      "rule_name": "Ensure mounting of cramfs filesystems is disabled",
      "rule_description": "Level 2: The cramfs filesystem type should be disabled.",
      "category": "Filesystem",
      "subcategory": "Filesystem Types",
      "testing_status": "verified",
      "assessment": {
        "severity": "Medium",
        "is_auto": true,
        "automation_level": "Full",
        "audit_type": "config",
        "detection_step": "Verify cramfs kernel module is disabled",
        "check_command": "modprobe -n -v cramfs | grep -E '(install /bin/true|not found)'",
        "expected_value": "install /bin/true or not found"
      },
      "remediation": {
        "remediation_step": "Create or edit /etc/modprobe.d/cramfs.conf with: install cramfs /bin/true",
        "rollback_supported": true,
        "reboot_required": false,
        "service_impact": "None",
        "estimated_time": "1 minute"
      },
      "context": {
        "rationale": "Unused filesystem drivers increase attack surface.",
        "impact": "Low - Reduces potential attack vectors",
        "false_positive_risk": "Low"
      },
      "tags": ["filesystem", "kernel-modules", "hardening", "workstation", "level2"]
    },
    {
      "rule_id": "CIS-WS-L2-1.1.23",
      "rule_name": "Ensure /var/log is a separate partition",
      "rule_description": "Level 2: The /var/log directory should be on a separate partition.",
      "category": "Filesystem",
      "subcategory": "Partitioning",
      "testing_status": "verified",
      "assessment": {
        "severity": "Medium",
        "is_auto": true,
        "automation_level": "Full",
        "audit_type": "config",
        "detection_step": "Verify /var/log is a separate partition",
        "check_command": "mount | grep ' /var/log '",
        "expected_value": "Separate mount point for /var/log"
      },
      "remediation": {
        "remediation_step": "Create separate partition for /var/log",
        "rollback_supported": false,
        "reboot_required": true,
        "service_impact": "Requires system reconfiguration",
        "estimated_time": "60 minutes"
      },
      "context": {
        "rationale": "Separate log partition prevents disk exhaustion from affecting system.",
        "impact": "Medium - Improves system resilience",
        "false_positive_risk": "None"
      },
      "tags": ["filesystem", "partitioning", "logs", "workstation", "level2"]
    },
    {
      "rule_id": "CIS-WS-L2-1.3.2",
      "rule_name": "Ensure filesystem integrity is regularly checked",
      "rule_description": "Level 2: AIDE should be configured to run regular file integrity checks.",
      "category": "File Integrity",
      "subcategory": "AIDE",
      "testing_status": "verified",
      "assessment": {
        "severity": "Medium",
        "is_auto": true,
        "automation_level": "Full",
        "audit_type": "config",
        "detection_step": "Verify AIDE cron job is configured",
        "check_command": "grep -r aide /etc/cron.* /etc/crontab /var/spool/cron/*",
        "expected_value": "AIDE check cron entry should be present"
      },
      "remediation": {
        "remediation_step": "Create cron job: 0 5 * * * /usr/sbin/aide --check",
        "rollback_supported": true,
        "reboot_required": false,
        "service_impact": "Daily integrity checks",
        "estimated_time": "2 minutes"
      },
      "context": {
        "rationale": "Regular integrity checks detect unauthorized file changes.",
        "impact": "High - Essential for intrusion detection",
        "false_positive_risk": "Low"
      },
      "tags": ["file-integrity", "aide", "cron", "workstation", "level2"]
    },
    {
      "rule_id": "CIS-WS-L2-1.7.1",
