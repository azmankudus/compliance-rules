        "reboot_required": false,
        "service_impact": "None",
        "estimated_time": "2 minutes"
      },
      "context": {
        "rationale": "Warning banners support legal prosecution of unauthorized access.",
        "impact": "Low - Legal/compliance requirement",
        "false_positive_risk": "None"
      },
      "tags": ["banners", "motd", "compliance", "workstation", "level2"]
    },
