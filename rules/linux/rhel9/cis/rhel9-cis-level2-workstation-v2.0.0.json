    {
      "rule_id": "CIS-WS-L2-6.1.10",
      "rule_name": "Ensure no world-writable files exist",
      "rule_description": "Level 2: No files should be world-writable.",
      "category": "File Permissions",
      "subcategory": "World-Writable",
      "testing_status": "verified",
      "assessment": {
        "severity": "Medium",
        "is_auto": true,
        "automation_level": "Full",
        "audit_type": "config",
        "detection_step": "Find world-writable files",
        "check_command": "df --local -P | awk '{if (NR!=1) print $6}' | xargs -I '{}' find '{}' -xdev -type f -perm -0002",
        "expected_value": "No output (no world-writable files)"
      },
      "remediation": {
        "remediation_step": "Remove world-writable permission: chmod o-w <file>",
        "rollback_supported": true,
        "reboot_required": false,
        "service_impact": "May affect some applications",
        "estimated_time": "10 minutes"
      },
      "context": {
        "rationale": "World-writable files allow any user to modify them.",
        "impact": "Medium - Prevents unauthorized file modification",
        "false_positive_risk": "Low"
      },
      "tags": ["permissions", "world-writable", "workstation", "level2"]
    },
