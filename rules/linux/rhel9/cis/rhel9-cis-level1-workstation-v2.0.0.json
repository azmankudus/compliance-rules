      "testing_status": "verified",
      "assessment": {
        "severity": "High",
        "is_auto": true,
        "automation_level": "Full",
        "audit_type": "config",
        "detection_step": "Verify SELinux mode",
        "check_command": "getenforce",
        "expected_value": "Enforcing"
      },
      "remediation": {
        "remediation_step": "Set SELinux to enforcing: Edit /etc/selinux/config: SELINUX=enforcing",
        "rollback_supported": true,
        "reboot_required": true,
        "service_impact": "May require policy adjustments",
        "estimated_time": "10 minutes"
      },
      "context": {
        "rationale": "Enforcing mode actively blocks policy violations.",
        "impact": "Critical - Core security control",
        "false_positive_risk": "Low"
      },
      "tags": ["selinux", "enforcing", "security", "critical", "workstation"]
    },
    {
      "rule_id": "CIS-WS-1.8.1",
