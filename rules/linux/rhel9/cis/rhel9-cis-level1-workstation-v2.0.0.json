      "assessment": {
        "severity": "High",
        "is_auto": true,
        "automation_level": "Full",
        "audit_type": "config",
        "detection_step": "Verify pwquality configuration",
        "check_command": "grep -E '^(minlen|minclass|dcredit|ucredit|lcredit|ocredit)' /etc/security/pwquality.conf",
        "expected_value": "minlen = 14 or more, minclass = 4 or appropriate credit settings"
      },
      "remediation": {
        "remediation_step": "Configure /etc/security/pwquality.conf with strong password requirements",
        "rollback_supported": true,
        "reboot_required": false,
        "service_impact": "Affects new password creation",
        "estimated_time": "2 minutes"
      },
      "context": {
        "rationale": "Strong passwords are essential for authentication security.",
        "impact": "High - Prevents weak passwords",
        "false_positive_risk": "None"
      },
      "tags": ["authentication", "passwords", "policy", "workstation"]
    },
    {
