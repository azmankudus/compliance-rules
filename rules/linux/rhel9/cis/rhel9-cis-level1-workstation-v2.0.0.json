  "rules": [
    {
      "rule_id": "CIS-WS-1.1.1.1",
      "rule_name": "Ensure mounting of cramfs filesystems is disabled",
      "rule_description": "The cramfs filesystem type is a compressed read-only Linux filesystem embedded in small footprint systems.",
      "category": "Filesystem",
      "subcategory": "Filesystem Types",
      "testing_status": "verified",
      "assessment": {
        "severity": "Medium",
        "is_auto": true,
        "automation_level": "Full",
        "audit_type": "config",
        "detection_step": "Verify cramfs kernel module is disabled",
        "check_command": "modprobe -n -v cramfs | grep -E '(install /bin/true|not found)'",
        "expected_value": "install /bin/true or not found"
      },
      "remediation": {
        "remediation_step": "Create or edit /etc/modprobe.d/cramfs.conf with: install cramfs /bin/true",
        "rollback_supported": true,
        "reboot_required": false,
        "service_impact": "None",
        "estimated_time": "1 minute"
      },
      "context": {
        "rationale": "Unused filesystem drivers increase attack surface.",
        "impact": "Low - Reduces potential attack vectors",
        "false_positive_risk": "Low"
      },
      "tags": ["filesystem", "kernel-modules", "hardening", "workstation"]
    },
    {
      "rule_id": "CIS-WS-1.1.2.1",
      "rule_name": "Ensure /tmp is configured",
      "rule_description": "The /tmp directory should be configured as a separate filesystem with appropriate mount options.",
      "category": "Filesystem",
      "subcategory": "Partitioning",
      "testing_status": "verified",
      "assessment": {
        "severity": "Medium",
        "is_auto": true,
        "automation_level": "Full",
        "audit_type": "config",
        "detection_step": "Verify /tmp is a separate mount point",
        "check_command": "mount | grep ' /tmp '",
        "expected_value": "/tmp on /tmp type tmpfs or separate partition"
      },
      "remediation": {
        "remediation_step": "Configure /tmp as tmpfs or separate partition in /etc/fstab with nodev,nosuid,noexec options",
        "rollback_supported": false,
        "reboot_required": true,
        "service_impact": "Requires filesystem reconfiguration",
        "estimated_time": "30 minutes"
      },
      "context": {
        "rationale": "Separate /tmp prevents resource exhaustion and allows restrictive mount options.",
        "impact": "Medium - Improves security and stability",
        "false_positive_risk": "None"
      },
      "tags": ["filesystem", "partitioning", "tmp", "workstation"]
    },
    {
      "rule_id": "CIS-WS-1.2.1",
      "rule_name": "Ensure package manager repositories are configured",
      "rule_description": "Systems need to have package manager repositories configured for security updates.",
      "category": "Package Management",
      "subcategory": "Repository Configuration",
      "testing_status": "verified",
      "assessment": {
        "severity": "Medium",
        "is_auto": true,
        "automation_level": "Partial",
        "audit_type": "config",
        "detection_step": "Verify repositories are configured",
        "check_command": "dnf repolist",
        "expected_value": "At least one enabled repository"
      },
      "remediation": {
        "remediation_step": "Configure appropriate package repositories",
        "rollback_supported": true,
        "reboot_required": false,
        "service_impact": "None",
        "estimated_time": "5 minutes"
      },
      "context": {
        "rationale": "Configured repositories are essential for receiving security updates.",
        "impact": "High - Required for system security",
        "false_positive_risk": "None"
      },
      "tags": ["packages", "repositories", "updates", "workstation"]
    },
    {
      "rule_id": "CIS-WS-1.3.1",
      "rule_name": "Ensure AIDE is installed",
      "rule_description": "Advanced Intrusion Detection Environment (AIDE) provides file integrity checking.",
      "category": "File Integrity",
      "subcategory": "AIDE",
      "testing_status": "verified",
      "assessment": {
        "severity": "Medium",
        "is_auto": true,
        "automation_level": "Full",
        "audit_type": "config",
        "detection_step": "Verify AIDE package is installed",
        "check_command": "rpm -q aide",
        "expected_value": "aide-<version>"
      },
      "remediation": {
        "remediation_step": "Install AIDE: dnf install aide && aide --init && mv /var/lib/aide/aide.db.new.gz /var/lib/aide/aide.db.gz",
        "rollback_supported": true,
        "reboot_required": false,
        "service_impact": "Initial database creation may take time",
        "estimated_time": "15 minutes"
      },
      "context": {
        "rationale": "File integrity monitoring detects unauthorized file changes.",
        "impact": "High - Essential for intrusion detection",
        "false_positive_risk": "Low"
      },
      "tags": ["file-integrity", "aide", "intrusion-detection", "workstation"]
    },
    {
      "rule_id": "CIS-WS-1.4.1",
      "rule_name": "Ensure bootloader password is set",
      "rule_description": "Setting the bootloader password protects against unauthorized changes to boot parameters.",
      "category": "Boot Configuration",
      "subcategory": "GRUB Security",
      "testing_status": "verified",
      "assessment": {
        "severity": "High",
        "is_auto": true,
        "automation_level": "Full",
        "audit_type": "config",
        "detection_step": "Verify GRUB password is configured",
        "check_command": "grep -E 'password_pbkdf2|GRUB2_PASSWORD' /boot/grub2/grub.cfg /etc/grub.d/01_users 2>/dev/null",
        "expected_value": "Password entry should be present"
      },
      "remediation": {
        "remediation_step": "Set GRUB password: grub2-setpassword && grub2-mkconfig -o /boot/grub2/grub.cfg",
        "rollback_supported": true,
        "reboot_required": false,
        "service_impact": "None until reboot",
        "estimated_time": "5 minutes"
      },
      "context": {
        "rationale": "Bootloader password prevents unauthorized modification of boot parameters.",
        "impact": "High - Critical for physical security",
        "false_positive_risk": "None"
      },
      "tags": ["boot", "grub", "password", "security", "workstation"]
    },
    {
