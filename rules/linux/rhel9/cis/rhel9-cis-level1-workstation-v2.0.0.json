      "remediation": {
        "remediation_step": "Add or modify in /etc/ssh/sshd_config: PermitRootLogin no",
        "rollback_supported": true,
        "reboot_required": false,
        "service_impact": "Root SSH login blocked",
        "estimated_time": "1 minute"
      },
      "context": {
        "rationale": "Preventing direct root login improves accountability.",
        "impact": "High - Critical security control",
        "false_positive_risk": "None"
      },
      "tags": ["ssh", "root", "authentication", "critical", "workstation"]
    },
    {
      "rule_id": "CIS-WS-5.2.9",
      "rule_name": "Ensure SSH PermitEmptyPasswords is disabled",
