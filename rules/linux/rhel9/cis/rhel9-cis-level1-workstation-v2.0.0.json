    {
      "rule_id": "CIS-WS-5.2.1",
      "rule_name": "Ensure permissions on /etc/ssh/sshd_config are configured",
      "rule_description": "The SSH configuration file must have proper permissions.",
      "category": "SSH Configuration",
      "subcategory": "File Permissions",
      "testing_status": "verified",
      "assessment": {
        "severity": "Medium",
        "is_auto": true,
        "automation_level": "Full",
        "audit_type": "config",
        "detection_step": "Verify sshd_config permissions",
        "check_command": "stat -c '%a %U %G %n' /etc/ssh/sshd_config",
        "expected_value": "600 root root /etc/ssh/sshd_config"
      },
      "remediation": {
        "remediation_step": "Set proper permissions: chmod 600 /etc/ssh/sshd_config && chown root:root /etc/ssh/sshd_config",
        "rollback_supported": true,
        "reboot_required": false,
        "service_impact": "None",
        "estimated_time": "1 minute"
      },
      "context": {
        "rationale": "Protecting SSH config prevents unauthorized modifications.",
        "impact": "High - Prevents SSH configuration tampering",
        "false_positive_risk": "None"
      },
      "tags": ["ssh", "permissions", "file-permissions", "workstation"]
    },
    {
      "rule_id": "CIS-WS-5.2.8",
      "rule_name": "Ensure SSH root login is disabled",
      "rule_description": "Direct root login via SSH should be disabled.",
      "category": "SSH Configuration",
      "subcategory": "Root Access",
      "testing_status": "verified",
      "assessment": {
        "severity": "High",
        "is_auto": true,
        "automation_level": "Full",
        "audit_type": "config",
